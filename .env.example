# ServiceNow instance connection
SN_BASE_URL=https://devXXXXX.service-now.com
SN_USERNAME=your_servicenow_username
SN_PASSWORD=your_servicenow_password

# Server
PORT=3000
POLLING_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# SMTP / Email Notification Settings (optional — leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# JWT signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_jwt_secret_here_run_command_above_to_generate

# Allowed CORS origin for the dashboard
CORS_ORIGIN=http://localhost:3000

# Shared secret for webhook authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
WEBHOOK_SECRET=your_webhook_secret_here_run_command_above_to_generate

# Dashboard user accounts (email:bcrypt_hash:role, pipe-separated)
# Generate hashes with: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
# Below are example users with password: admin123
AUTH_USERS=admin@servicenow.com:$2b$12$nYflnK6si/2B0GxntbJpF.X.XQm7hukTgLXTJRYqach2cjAuTGDOC:admin|im@servicenow.com:$2b$12$dBUGGhRShrC9bserbPhs5Oja8EijlUneFBeQGGrHJq9MLy1AUqfeO:admin|readonly@servicenow.com:$2b$12$Pi0fYKzYwML2Fk5gWUz5oeZoXY9927KrxXZKcZOLhIRfB0KWz4hsa:readonly
